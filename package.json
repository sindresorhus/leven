{
	"name": "leven",
	"version": "4.2.0",
	"description": "Measure the difference between two strings using the Levenshtein distance algorithm",
	"license": "MIT",
	"repository": "sindresorhus/leven",
	"funding": "https://github.com/sponsors/sindresorhus",
	"author": "Sindre Sorhus <sindresorhus@gmail.com> (https://sindresorhus.com)",
	"type": "module",
	"exports": "./index.js",
	"types": "./index.d.ts",
	"sideEffects": false,
	"engines": {
		"node": "^12.20.0 || ^14.13.1 || >=16.0.0"
	},
	"scripts": {
		"test": "xo && node --test",
		"bench": "node bench.js"
	},
	"files": [
		"index.js",
		"index.d.ts"
	],
	"keywords": [
		"levenshtein",
		"distance",
		"algorithm",
		"string",
		"difference",
		"diff",
		"fast",
		"fuzzy",
		"similar",
		"similarity",
		"compare",
		"comparison",
		"edit",
		"text",
		"match",
		"matching"
	],
	"devDependencies": {
		"fast-levenshtein": "^3.0.0",
		"ld": "^0.1.0",
		"levdist": "^2.2.10",
		"levenshtein": "^1.0.5",
		"levenshtein-component": "^0.0.1",
		"levenshtein-edit-distance": "^3.0.0",
		"natural": "^5.0.4",
		"talisman": "^1.1.4",
		"tinybench": "^4.0.1",
		"xo": "^5.0.1"
	},
	"xo": [
		{
			"rules": {
				"unicorn/prefer-code-point": "off",
				"no-bitwise": "off",
				"node-test/no-conditional-assertion": "off"
			}
		},
		{
			"files": "package.json",
			"rules": {
				"package-json/require-types-in-exports": "off",
				"package-json/prefer-exports": "off"
			}
		}
	]
}
